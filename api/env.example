# App
APP_NAME=verbaflow-api
DEBUG=true
API_KEY=
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001

# Database
# Misma credencial que finance_portfolio / surplus: usuario postgres, BD dedicada verbaflow
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db.postgres.local:30432/verbaflow
# En K8s: host interno del cluster (secret + values DATABASE_HOST)
# DATABASE_HOST=postgres-service.postgres.svc.cluster.local

# CORS (coma-separado). En pre/pro coincide con el host del Gateway.
# CORS_ORIGINS=https://pre.verbaflow.juanfranciscoperez.es

# Surplus Intelligence (OpenAI-compatible)
SURPLUSINTELLIGENCE_API_KEY=
SURPLUS_BASE_URL=https://api.surplusintelligence.ai/v1
SURPLUS_MODEL_LOOKUP=gemini-2.5-flash

# Satélite Surplus (favoritos del panel → POST /api/pick)
SURPLUS_DATABASE_URL=postgresql://juanfran:CHANGE_ME@db.postgres.local:30432/surplus_provider
SURPLUS_SATELLITE_ENABLED=true
SURPLUS_SATELLITE_BASE_URL=https://surplus-satellite.juanfranciscoperez.es
SURPLUS_SATELLITE_MIN_DISCOUNT_PCT=80
SURPLUS_SATELLITE_MAX_OUTPUT_PRICE_PER_1M_USD=0.35
SURPLUS_SATELLITE_VERIFY_MODEL=false
SURPLUS_SATELLITE_PICK_TIMEOUT_SECONDS=30
OPENAI_TIMEOUT_SECONDS=120

# STT (faster-whisper)
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MAX_AUDIO_SECONDS=30

# Traducción: primero diccionario/Google (sin tokens); Surplus solo si falla o frase larga
LOOKUP_QUICK_TRANSLATE_ENABLED=true
LOOKUP_DICTIONARY_MAX_WORDS=6
LOOKUP_LLM_ENABLED=true
LOOKUP_LLM_TEMPERATURE=0.25
LOOKUP_LLM_MAX_TOKENS=512